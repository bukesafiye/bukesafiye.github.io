---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%} Every HTML page except those with `sitemap: false` (the /indir/ redirects). {%- endcomment %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.html_pages %}
{%- unless p.sitemap == false or p.url contains '404' %}
  <url><loc>{{ p.url | replace: 'index.html', '' | absolute_url }}</loc></url>
{%- endunless %}
{%- endfor %}
</urlset>
